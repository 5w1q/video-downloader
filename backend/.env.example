# 复制本文件为 .env 后填写真实值，切勿将 .env 提交到 Git
#
# 完全本地运行（Windows Docker / 本机）：docker-compose.yml 已注入 LOCAL_MODE=1 等覆盖项。
# 生产部署请关闭 LOCAL_MODE，并填写下方正式域名与 Ab / PG。

# ------------------------------
# 本地模式（不依赖 Ab 主站 / 公网服务器）
# ------------------------------
# LOCAL_MODE=1 时：虚拟登录用户、关闭 Ab 计费与用量上报；AI 总结可直接用
# LOCAL_MODE=1
# AB_BILLING_DISABLED=1
# AB_USAGE_REPORT_ENABLED=0
# ALIYUN_ASR_ENABLED=0

# ------------------------------
# 统一网关 / 前端域名
# ------------------------------
# 本地示例：
# APP_PUBLIC_DOMAIN=localhost
# FRONTEND_URL=http://localhost:8080
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
APP_PUBLIC_DOMAIN=video.sayhi-ab.asia
FRONTEND_URL=https://video.sayhi-ab.asia
# 逗号分隔；生产建议仅保留正式域名
CORS_ALLOWED_ORIGINS=https://video.sayhi-ab.asia,https://sayhi-ab.asia

# ------------------------------
# 数据库（建议：统一 PostgreSQL；不填则回退本地 SQLite）
# video-downloader 推荐库名：video_app
# ------------------------------
# DATABASE_URL=postgresql://video_app:<password>@<pg-host>:5432/video_app
# 连接池基线（与统一文档一致）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# DeepSeek AI（AI 总结/问答必填；Docker 请在宿主机 backend/.env 填写，compose 已通过 env_file 注入容器）
# 服务器须能访问 https://api.deepseek.com（防火墙/出站策略）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=change-me-to-a-long-random-string

# Stripe 支付（可选）
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_ID_MONTHLY=price_your_monthly_price_id

# --- Ab 主站统一登录与计费（必填）---
# 本地联调：Ab 在 3847，可改为 http://127.0.0.1:3847
# 生产环境：填主站域名 https://sayhi-ab.asia
AB_BASE_URL=https://sayhi-ab.asia
AB_LOGIN_PATH=/login.html
AB_APP_ID=video-downloader
# 可选：主站接口超时（秒）
# AB_TIMEOUT_SEC=20
# 可选：各能力扣费（元口径积分，可为小数如 0.29）。请求 try-consume 时会显式带 credits_cost；漏传的动作为 0，不按 Ab registry 误扣。
# 「summarize」未配置 AB_CREDITS_COST_SUMMARIZE 时在代码中有兜底单价（与定价文档一致）；可在此处覆盖。
# 批量下载 / 普通 /download API 不走 try-consume，不扣分。
# 填 0 表示本次动作扣 0 积分。
# AB_CREDITS_COST_DOWNLOAD=0
# AB_CREDITS_COST_SUMMARIZE=0.29
# AB_CREDITS_COST_CHAT=0
# AB_CREDITS_COST_BULK_DOWNLOAD=0
# AI 总结扣费后若生成失败，默认自动调用主站 refund-consume 返还积分/免费试次
# AB_BILLING_REFUND_DISABLED=1
# 可选：与 /etc/ab/ab-server.env 中 AB_BILLING_REFUND_SECRET 相同（内网密钥返还；不配则用用户 Cookie）
# AB_BILLING_REFUND_SECRET=

# --- 批量 ZIP 走 OSS + CDN（绕过 ECS 公网小带宽；不配则仍走 ECS 一次性 /api/bulk-download/zip）---
# ECS 与 Bucket 同地域建议 OSS_ENDPOINT 用内网，例如：http://oss-cn-shanghai-internal.aliyuncs.com
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
# OSS_BUCKET=video-prod-files
# OSS_BULK_PREFIX=bulk-zip
# 浏览器下载使用的 CDN 域名（勿尾斜杠）；需 CDN 源站指向该 Bucket，且建议仅对 bulk-zip/* 配置缓存
# OSS_CDN_BASE_URL=https://your.cdn.example.com
# 单卷 ZIP 上限（分卷打包；默认每卷约 2GB 或 25 个文件，取先到者）
# 1000×200MB 会拆成约 80 卷，可边下边传 OSS/CDN，不必等全部完成再下载
# BULK_ZIP_MAX_BYTES=2147483648
# BULK_ZIP_MAX_FILES=25
# 本地 ZIP 令牌落盘目录为 data/bulk_zip_tokens/（多 worker 共享；勿改成仅内存）

# --- yt-dlp 下载重试（缓解代理断开 / SSL EOF）---
# YTDLP_DOWNLOAD_RETRIES=5
# YTDLP_FRAGMENT_RETRIES=5
# 整次下载外层重试次数（1–5，默认 3）
# YTDLP_DOWNLOAD_ATTEMPTS=3

# --- YouTube 关键词搜索（接入 bulk 批量下载）---
# 单次最多返回条数上限（1–50，默认 20）
# YOUTUBE_SEARCH_MAX_RESULTS=20
# 有播放量/点赞阈值时，扩大搜索池再筛选（1–50，默认 40）
# YOUTUBE_SEARCH_POOL=40

# --- X（Twitter）关键词搜索（Apify Advanced Search）---
# APIFY_TOKEN=apify_api_xxxxxxxx
# X_SEARCH_ACTOR_ID=api-ninja/x-twitter-advanced-search
# X_SEARCH_MAX_RESULTS=20
# X_SEARCH_POOL=40

# --- Instagram Reels 关键词搜索（ScrapeCreators）---
# SCRAPECREATORS_API_KEY=your_scrapecreators_api_key
# INSTAGRAM_SEARCH_MAX_RESULTS=20
# INSTAGRAM_SEARCH_POOL=40
# Instagram 下载常需登录 Cookie（empty media response）。勿复用 bilibili_cookies.txt：
# INSTAGRAM_COOKIEFILE=secrets/instagram_cookies.txt
# 本机调试也可：YTDLP_COOKIES_FROM_BROWSER=chrome|edge（仅当未设 INSTAGRAM_COOKIEFILE）

# --- TikTok 单链解析/下载（同用 SCRAPECREATORS_API_KEY）---
# 本机代理出口若为香港，TikTok 网页会重定向到 /hk/about，yt-dlp 无法解析；
# 单链走 ScrapeCreators Video Info（GET /v2/tiktok/video）取 CDN 直链。
# 可选：指定 ScrapeCreators 侧代理地区（如 US / GB），部分地区视频需要：
# TIKTOK_SCRAPECREATORS_REGION=US
# 可选：仅当仍走 yt-dlp 时使用的专用 Cookie（勿复用 bilibili_cookies.txt）：
# TIKTOK_COOKIEFILE=secrets/tiktok_cookies.txt

# --- 阿里云 Paraformer 语音转写（无真实字幕时备用；非 OpenAI Whisper）---
# 抖音等若无 subtitle 轨道，会先以内层 desc 占位，但仍会调用此处尝试转写（见 summarizer.SubtitleExtractor.extract）。
# 需百炼 API Key（北京）+ 公网站点根 URL（供阿里云下载短时音频；不可用 localhost）
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# PUBLIC_BASE_URL=https://你的域名
# ALIYUN_ASR_MODEL=paraformer-v2
# ALIYUN_ASR_MAX_SECONDS=3600
# ALIYUN_ASR_ENABLED=1

# --- AI 总结：字幕提取阶段超时（秒，含 yt-dlp 与阿里云转写排队）---
# SUMMARIZE_EXTRACT_TIMEOUT_SEC=1200
# SUMMARIZE_EXTRACT_HEARTBEAT_SEC=12
# 抖音：平台字幕/desc 为空时是否再尝试 yt-dlp（常需 Cookie，默认关闭）
# DOUYIN_TRY_YTDLP_SUBTITLES=0

# B 站等：云服务器出口 IP 易返回 HTTP 412。将本机浏览器登录 bilibili.com 后导出的 Netscape 格式
# cookies.txt 放到服务器（勿提交 Git），填写容器内可读绝对路径，例如挂载 /app/secrets/cookies.txt：
# YTDLP_COOKIEFILE=/app/secrets/bilibili_cookies.txt
# 可选别名：BILIBILI_COOKIEFILE（与上一项二选一即可）
# YouTube 专用 Cookie（可选）。勿把 bilibili_cookies.txt 用于 YouTube：
# 带 cookie 时 yt-dlp 会跳过 android 客户端，易出现「Requested format is not available」。
# YOUTUBE_COOKIEFILE=secrets/youtube_cookies.txt
# Docker 也可用绝对路径：/app/secrets/youtube_cookies.txt（需挂载 secrets 卷）
# 带 Cookie 时需 JS runtime 解 n-challenge（默认 node；镜像内须安装 node + pip 包 yt-dlp-ejs）
# YTDLP_JS_RUNTIMES=node
# 本地开发可直接复用浏览器 Cookie（Windows 上若报 DPAPI 解密失败，请改回 cookie 文件）：
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_BROWSER_PROFILE=Default
# 可选：浏览器指纹模拟（需安装 curl-cffi，可缓解部分 B 站 412）
# YTDLP_IMPERSONATE=chrome
# 解析阶段网络超时（秒，默认 30；仅用于 parse/direct-url，避免前端长时间“解析中”）
# YTDLP_PARSE_SOCKET_TIMEOUT=30
# 若 412 消失后出现「geo-restricted / try a proxy」：多为海外 IP 播控，必须配置可走大陆 B 站的代理，例如：
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# （代理须在容器内可达；若代理在宿主机，勿写 127.0.0.1，应写宿主机在 Docker 网桥上的 IP。）

# --- 下载文件名：按视频内容生成短标题（最多 30 字）---
# 下载完成后提取字幕/转写，再用 AI 写标题并重命名文件；需已配置 DEEPSEEK_API_KEY 或 SUMMARIZE_LLM_API_KEY。
# 无字幕且未配 ASR 时，会回退为平台标题（同样截断到 30 字）。
# 设为 0 可关闭，恢复平台原始标题命名。
# CONTENT_TITLE_ON_DOWNLOAD=1

# Docker / 长期运行：退出进程时不删除 downloads 目录（docker-compose 已默认开启）
# PERSIST_DOWNLOADS=1

# --- 试用期（可选）---
# 若镜像/挂载中存在 backend/keys/trial_public.pem，则必须设置由你方私钥签发的 JWT：
# TRIAL_LICENSE=eyJhbGciOiJSUzI1NiIs...
# 公钥路径覆盖（可选）:
# TRIAL_PUBLIC_KEY_FILE=/app/keys/trial_public.pem
# 调试（可选）:
# TRIAL_GATE_DEBUG=1
